--- /dev/null	2026-10-27 08:34:02.578761355 +0100
+++ b/sys/dev/i2c/ht1382.c	2026-10-27 17:10:33.982050772 +0100
@@ -0,0 +1,263 @@
+/*	$NetBSD$	*/
+
+/*
+ * Holtek HT1382 I2C real-time clock with wake-up alarm
+ * (Zyxel NSA310S: iic0 address 0x68).
+ *
+ * Register layout and sequences taken from the stock Zyxel firmware
+ * (/sbin/rtcAccess):
+ *   0x00 sec, 0x01 min, 0x02 hour (bit 7 = 24h mode), 0x03 day,
+ *   0x04 month, 0x05 weekday, 0x06 year (all BCD, UTC),
+ *   0x07 write protect (bit 7), 0x08/0x09 control (0x80/0xc0),
+ *   0x0b alarm min, 0x0c alarm hour, 0x0d alarm day (bit 7 = enable).
+ *   Reading 0x08 clears the alarm flag.
+ *
+ * The alarm drives the board's power-on logic, so a powered-off NAS
+ * switches itself on at the programmed time.  hw.htrtcN.wakeup takes
+ * a UNIX time (UTC); 0 disables the alarm.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+#include <sys/kernel.h>
+#include <sys/sysctl.h>
+
+#include <dev/clock_subr.h>
+#include <dev/i2c/i2cvar.h>
+
+#define HTRTC_SEC	0x00
+#define HTRTC_MIN	0x01
+#define HTRTC_HOUR	0x02
+#define  HTRTC_HOUR_24	0x80
+#define HTRTC_DAY	0x03
+#define HTRTC_MONTH	0x04
+#define HTRTC_WDAY	0x05
+#define HTRTC_YEAR	0x06
+#define HTRTC_WP	0x07
+#define HTRTC_CTRL1	0x08		/* read clears the alarm flag */
+#define HTRTC_CTRL2	0x09
+#define HTRTC_AMIN	0x0b
+#define HTRTC_AHOUR	0x0c
+#define HTRTC_ADAY	0x0d
+#define  HTRTC_AEN	0x80
+
+struct htrtc_softc {
+	device_t		sc_dev;
+	i2c_tag_t		sc_tag;
+	i2c_addr_t		sc_addr;
+	struct todr_chip_handle	sc_todr;
+	int64_t			sc_wakeup;
+};
+
+static int	htrtc_match(device_t, cfdata_t, void *);
+static void	htrtc_attach(device_t, device_t, void *);
+
+CFATTACH_DECL_NEW(htrtc, sizeof(struct htrtc_softc),
+    htrtc_match, htrtc_attach, NULL, NULL);
+
+static const struct device_compatible_entry compat_data[] = {
+	{ .compat = "htk,ht1382" },
+	DEVICE_COMPAT_EOL
+};
+
+static int
+htrtc_read(struct htrtc_softc *sc, uint8_t reg, uint8_t *val)
+{
+	return iic_smbus_read_byte(sc->sc_tag, sc->sc_addr, reg, val, 0);
+}
+
+static int
+htrtc_write(struct htrtc_softc *sc, uint8_t reg, uint8_t val)
+{
+	return iic_smbus_write_byte(sc->sc_tag, sc->sc_addr, reg, val, 0);
+}
+
+static int
+htrtc_gettime_ymdhms(todr_chip_handle_t ch, struct clock_ymdhms *dt)
+{
+	struct htrtc_softc *sc = ch->cookie;
+	uint8_t r[7];
+	int error, i;
+
+	if ((error = iic_acquire_bus(sc->sc_tag, 0)) != 0)
+		return error;
+	for (i = 0; i < 7 && error == 0; i++)
+		error = htrtc_read(sc, HTRTC_SEC + i, &r[i]);
+	iic_release_bus(sc->sc_tag, 0);
+	if (error)
+		return error;
+
+	dt->dt_sec = bcdtobin(r[HTRTC_SEC] & 0x7f);
+	dt->dt_min = bcdtobin(r[HTRTC_MIN] & 0x7f);
+	dt->dt_hour = bcdtobin(r[HTRTC_HOUR] & 0x3f);
+	dt->dt_day = bcdtobin(r[HTRTC_DAY] & 0x3f);
+	dt->dt_mon = bcdtobin(r[HTRTC_MONTH] & 0x1f);
+	dt->dt_wday = bcdtobin(r[HTRTC_WDAY] & 0x07) % 7;
+	dt->dt_year = 2000 + bcdtobin(r[HTRTC_YEAR]);
+	return 0;
+}
+
+static int
+htrtc_settime_ymdhms(todr_chip_handle_t ch, struct clock_ymdhms *dt)
+{
+	struct htrtc_softc *sc = ch->cookie;
+	int error;
+
+	if (dt->dt_year < 2000 || dt->dt_year > 2099)
+		return EINVAL;
+	if ((error = iic_acquire_bus(sc->sc_tag, 0)) != 0)
+		return error;
+	error = htrtc_write(sc, HTRTC_WP, 0);
+	if (!error)
+		error = htrtc_write(sc, HTRTC_SEC, bintobcd(dt->dt_sec));
+	if (!error)
+		error = htrtc_write(sc, HTRTC_MIN, bintobcd(dt->dt_min));
+	if (!error)
+		error = htrtc_write(sc, HTRTC_HOUR,
+		    bintobcd(dt->dt_hour) | HTRTC_HOUR_24);
+	if (!error)
+		error = htrtc_write(sc, HTRTC_DAY, bintobcd(dt->dt_day));
+	if (!error)
+		error = htrtc_write(sc, HTRTC_MONTH, bintobcd(dt->dt_mon));
+	if (!error)
+		error = htrtc_write(sc, HTRTC_WDAY, bintobcd(dt->dt_wday));
+	if (!error)
+		error = htrtc_write(sc, HTRTC_YEAR,
+		    bintobcd(dt->dt_year - 2000));
+	iic_release_bus(sc->sc_tag, 0);
+	return error;
+}
+
+/* Program (t != 0) or disable (t == 0) the wake-up alarm. */
+static int
+htrtc_set_alarm(struct htrtc_softc *sc, int64_t t)
+{
+	struct clock_ymdhms dt;
+	uint8_t amin = 0, ahour = 0, aday = 0, dummy;
+	int error;
+
+	if (t != 0) {
+		clock_secs_to_ymdhms((time_t)t, &dt);
+		amin = bintobcd(dt.dt_min) | HTRTC_AEN;
+		ahour = bintobcd(dt.dt_hour) | HTRTC_AEN;
+		aday = bintobcd(dt.dt_day) | HTRTC_AEN;
+	}
+	if ((error = iic_acquire_bus(sc->sc_tag, 0)) != 0)
+		return error;
+	error = htrtc_write(sc, HTRTC_WP, 0);
+	if (!error)
+		error = htrtc_write(sc, HTRTC_AMIN, amin);
+	if (!error)
+		error = htrtc_write(sc, HTRTC_AHOUR, ahour);
+	if (!error)
+		error = htrtc_write(sc, HTRTC_ADAY, aday);
+	if (!error)
+		error = htrtc_read(sc, HTRTC_CTRL1, &dummy);	/* clear AF */
+	iic_release_bus(sc->sc_tag, 0);
+	return error;
+}
+
+static int
+htrtc_sysctl_wakeup(SYSCTLFN_ARGS)
+{
+	struct sysctlnode node = *rnode;
+	struct htrtc_softc *sc = node.sysctl_data;
+	int64_t t = sc->sc_wakeup;
+	int error;
+
+	node.sysctl_data = &t;
+	error = sysctl_lookup(SYSCTLFN_CALL(&node));
+	if (error || newp == NULL)
+		return error;
+	if (t < 0)
+		return EINVAL;
+	if (t != 0 && t <= time_second)
+		return EINVAL;			/* alarm in the past */
+	if (t != 0 && t - time_second > 27 * 86400)
+		return EINVAL;			/* matches day-of-month only */
+	if ((error = htrtc_set_alarm(sc, t)) != 0)
+		return error;
+	sc->sc_wakeup = t;
+	return 0;
+}
+
+static int
+htrtc_match(device_t parent, cfdata_t cf, void *aux)
+{
+	struct i2c_attach_args *ia = aux;
+	int match_result;
+
+	if (iic_use_direct_match(ia, cf, compat_data, &match_result))
+		return match_result;
+	/* indirect config: only the address from the kernel config */
+	if (ia->ia_addr == 0x68)
+		return I2C_MATCH_ADDRESS_ONLY;
+	return 0;
+}
+
+static void
+htrtc_attach(device_t parent, device_t self, void *aux)
+{
+	struct htrtc_softc *sc = device_private(self);
+	struct i2c_attach_args *ia = aux;
+	const struct sysctlnode *node;
+	uint8_t amin, ahour, aday, hour, dummy;
+	int error;
+
+	sc->sc_dev = self;
+	sc->sc_tag = ia->ia_tag;
+	sc->sc_addr = ia->ia_addr;
+
+	aprint_naive("\n");
+	aprint_normal(": HT1382 Real-time Clock\n");
+
+	if (iic_acquire_bus(sc->sc_tag, 0) != 0) {
+		aprint_error_dev(self, "cannot acquire bus\n");
+		return;
+	}
+	error = htrtc_read(sc, HTRTC_AMIN, &amin);
+	if (!error)
+		error = htrtc_read(sc, HTRTC_AHOUR, &ahour);
+	if (!error)
+		error = htrtc_read(sc, HTRTC_ADAY, &aday);
+	if (!error)
+		error = htrtc_read(sc, HTRTC_HOUR, &hour);
+	/* as rtcAccess "init" does: no write protect, 24h mode */
+	if (!error)
+		error = htrtc_write(sc, HTRTC_WP, 0);
+	if (!error && !(hour & HTRTC_HOUR_24))
+		error = htrtc_write(sc, HTRTC_HOUR, hour | HTRTC_HOUR_24);
+	if (!error)
+		error = htrtc_read(sc, HTRTC_CTRL1, &dummy);	/* clear AF */
+	iic_release_bus(sc->sc_tag, 0);
+	if (error) {
+		aprint_error_dev(self, "register access failed (%d)\n",
+		    error);
+		return;
+	}
+	/* the alarm is one-shot: disarm it once we are up */
+	if ((amin | ahour | aday) & HTRTC_AEN) {
+		aprint_normal_dev(self,
+		    "wake-up alarm was set: day %02x %02x:%02x UTC, cleared\n",
+		    aday & 0x3f, ahour & 0x3f, amin & 0x7f);
+		htrtc_set_alarm(sc, 0);
+	}
+
+	sc->sc_todr.cookie = sc;
+	sc->sc_todr.todr_gettime_ymdhms = htrtc_gettime_ymdhms;
+	sc->sc_todr.todr_settime_ymdhms = htrtc_settime_ymdhms;
+	todr_attach(&sc->sc_todr);
+
+	if (sysctl_createv(NULL, 0, NULL, &node, 0, CTLTYPE_NODE,
+	    device_xname(self), SYSCTL_DESCR("HT1382 RTC"),
+	    NULL, 0, NULL, 0, CTL_HW, CTL_CREATE, CTL_EOL) == 0)
+		sysctl_createv(NULL, 0, NULL, NULL,
+		    CTLFLAG_READWRITE, CTLTYPE_QUAD, "wakeup",
+		    SYSCTL_DESCR("Power-on alarm, UNIX time UTC (0 = off)"),
+		    htrtc_sysctl_wakeup, 0, (void *)sc, 0,
+		    CTL_HW, node->sysctl_num, CTL_CREATE, CTL_EOL);
+}
