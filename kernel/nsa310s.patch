+#ifdef NSA310S
+/*
+ * Zyxel NSA310S: the stock firmware leaves the 88E1318S PHY (address 1)
+ * with its page register (22) set to 3 (LED page), so the ID registers
+ * read as 0 and mii(4) finds no PHY.  Select page 0 before mvgbe attaches
+ * and apply the LED setup from the Linux DTS (marvell,reg-init).
+ */
+static void
+nsa310s_smi_write(int phy, int reg, uint16_t val)
+{
+	volatile uint32_t *smi =
+	    (volatile uint32_t *)(MARVELL_INTERREGS_VBASE + 0x72004);
+	int i;
+
+	for (i = 0; i < 10000 && (*smi & (1 << 28)); i++)	/* busy */
+		delay(1);
+	*smi = (phy << 16) | (reg << 21) | val;			/* write op */
+	for (i = 0; i < 10000 && (*smi & (1 << 28)); i++)
+		delay(1);
+}
+
+/*
+ * Power off: GPIO27 high (Linux DTS: gpio-poweroff, active high).
+ * The board MCU then cuts power; the HT1382 alarm can switch it on again.
+ */
+static uint16_t
+nsa310s_smi_read(int phy, int reg)
+{
+	volatile uint32_t *smi =
+	    (volatile uint32_t *)(MARVELL_INTERREGS_VBASE + 0x72004);
+	uint32_t v;
+	int i;
+
+	for (i = 0; i < 10000 && (*smi & (1 << 28)); i++)	/* busy */
+		delay(1);
+	*smi = (phy << 16) | (reg << 21) | (1 << 26);		/* read op */
+	for (i = 0; i < 10000 && (*smi & (1 << 28)); i++)
+		delay(1);
+	for (i = 0; i < 10000; i++) {
+		v = *smi;
+		if (v & (1 << 27))				/* read valid */
+			return v & 0xffff;
+		delay(1);
+	}
+	return 0xffff;
+}
+
+/*
+ * Arm magic-packet Wake-on-LAN in the 88E1318S (as Linux m88e1318_set_wol):
+ * the PHY pulls LED[2]/INTn low on a magic packet and the board MCU powers
+ * the NAS on.  The MAC address is taken from the GbE port registers.
+ */
+static void
+nsa310s_wol_arm(void)
+{
+	uint32_t ah = *(volatile uint32_t *)(MARVELL_INTERREGS_VBASE + 0x72418);
+	uint32_t al = *(volatile uint32_t *)(MARVELL_INTERREGS_VBASE + 0x72414);
+	uint8_t a[6] = { ah >> 24, ah >> 16, ah >> 8, ah, al >> 8, al };
+	uint16_t v;
+
+	nsa310s_smi_write(1, 22, 0);				/* copper page */
+	v = nsa310s_smi_read(1, 0);
+	nsa310s_smi_write(1, 0, v & ~(1 << 11));		/* not powered down */
+	(void)nsa310s_smi_read(1, 0x13);			/* clear events */
+	v = nsa310s_smi_read(1, 0x12);
+	nsa310s_smi_write(1, 0x12, v | (1 << 7));		/* WOL event irq */
+
+	nsa310s_smi_write(1, 22, 3);				/* LED page */
+	v = nsa310s_smi_read(1, 0x12);
+	v &= ~(1 << 15);					/* no forced int */
+	v |= (1 << 7) | (1 << 11);				/* INTn, active low */
+	nsa310s_smi_write(1, 0x12, v);
+
+	nsa310s_smi_write(1, 22, 0x11);				/* WOL page */
+	nsa310s_smi_write(1, 0x17, (a[5] << 8) | a[4]);
+	nsa310s_smi_write(1, 0x18, (a[3] << 8) | a[2]);
+	nsa310s_smi_write(1, 0x19, (a[1] << 8) | a[0]);
+	v = nsa310s_smi_read(1, 0x10);
+	nsa310s_smi_write(1, 0x10, v | (1 << 12) | (1 << 14));	/* clr + magic */
+
+	nsa310s_smi_write(1, 22, 0);
+	printf("nsa310s: Wake-on-LAN armed for %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    a[0], a[1], a[2], a[3], a[4], a[5]);
+}
+
+static void
+nsa310s_powerdown(void)
+{
+	volatile uint32_t *gpp =
+	    (volatile uint32_t *)(MARVELL_INTERREGS_VBASE + 0x10100);
+
+	nsa310s_wol_arm();
+
+	/* same sequence as Linux gpio-poweroff: high, low, high */
+	gpp[0] |= (1U << 27);		/* data out */
+	gpp[1] &= ~(1U << 27);		/* output enable (0 = output) */
+	delay(100000);
+	gpp[0] &= ~(1U << 27);
+	delay(100000);
+	gpp[0] |= (1U << 27);
+	delay(3000000);
+}
+
+/*
+ * Front/back buttons, polled every 100 ms and reported to powerd(8):
+ * power (GPIO26, active high), reset (GPIO24) and copy (GPIO25, active low).
+ * powerd runs /etc/powerd/scripts/{power,reset,hotkey}_button.
+ */
+static struct sysmon_pswitch nsa310s_psw[] = {
+	{ .smpsw_name = "power", .smpsw_type = PSWITCH_TYPE_POWER },
+	{ .smpsw_name = "reset", .smpsw_type = PSWITCH_TYPE_RESET },
+	{ .smpsw_name = "copy",  .smpsw_type = PSWITCH_TYPE_HOTKEY },
+};
+static const struct {
+	int	pin;
+	bool	active_low;
+} nsa310s_btn[] = {
+	{ 26, false },
+	{ 24, true },
+	{ 25, true },
+};
+static bool nsa310s_btn_down[__arraycount(nsa310s_btn)];
+static callout_t nsa310s_btn_ch;
+static struct disk *nsa310s_wd;
+static uint64_t nsa310s_wd_xfer;
+
+static bool
+nsa310s_btn_pressed(uint32_t din, int i)
+{
+	return (((din >> nsa310s_btn[i].pin) & 1) != 0) !=
+	    nsa310s_btn[i].active_low;
+}
+
+static void
+nsa310s_btn_poll(void *arg)
+{
+	uint32_t din = *(volatile uint32_t *)
+	    (MARVELL_INTERREGS_VBASE + 0x10110);	/* GPIO data in */
+	int i;
+
+	for (i = 0; i < __arraycount(nsa310s_btn); i++) {
+		bool down = nsa310s_btn_pressed(din, i);
+
+		if (down == nsa310s_btn_down[i])
+			continue;
+		nsa310s_btn_down[i] = down;
+		sysmon_pswitch_event(&nsa310s_psw[i],
+		    down ? PSWITCH_EVENT_PRESSED : PSWITCH_EVENT_RELEASED);
+	}
+
+	/* HDD LED (GPIO16): on while wd0 is idle, blinks off on transfers */
+	if (nsa310s_wd == NULL)
+		nsa310s_wd = disk_find("wd0");
+	if (nsa310s_wd != NULL && nsa310s_wd->dk_stats != NULL) {
+		volatile uint32_t *dout = (volatile uint32_t *)
+		    (MARVELL_INTERREGS_VBASE + 0x10100);
+		uint64_t x = nsa310s_wd->dk_stats->io_rxfer +
+		    nsa310s_wd->dk_stats->io_wxfer;
+
+		if (x != nsa310s_wd_xfer)
+			*dout &= ~(1U << 16);
+		else
+			*dout |= (1U << 16);
+		nsa310s_wd_xfer = x;
+	}
+	callout_schedule(&nsa310s_btn_ch, hz / 10);
+}
+
+static int
+nsa310s_btn_init(device_t dev)
+{
+	static bool done;
+	uint32_t din = *(volatile uint32_t *)
+	    (MARVELL_INTERREGS_VBASE + 0x10110);
+	int i;
+
+	if (done)
+		return 0;
+	done = true;
+	for (i = 0; i < __arraycount(nsa310s_btn); i++) {
+		nsa310s_btn_down[i] = nsa310s_btn_pressed(din, i);
+		if (sysmon_pswitch_register(&nsa310s_psw[i]) != 0)
+			printf("nsa310s: cannot register %s button\n",
+			    nsa310s_psw[i].smpsw_name);
+	}
+	callout_init(&nsa310s_btn_ch, 0);
+	callout_setfunc(&nsa310s_btn_ch, nsa310s_btn_poll, NULL);
+	callout_schedule(&nsa310s_btn_ch, hz / 10);
+	return 0;
+}
+
+static void
+nsa310s_phyfix(void)
+{
+
+	nsa310s_smi_write(1, 22, 3);		/* page 3: LEDs */
+	nsa310s_smi_write(1, 16, 0x1017);
+	nsa310s_smi_write(1, 17, 0x4408);
+	nsa310s_smi_write(1, 22, 0);		/* back to page 0 */
+}
+#endif
